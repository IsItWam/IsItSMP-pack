	task.1272AF5BF1DC6A53.title: "Find: a Merchant Campsite"
	task.1279DA014CB6670C.title: "Find: the Bandit Towers"
	task.12D2065E0C3D6752.title: "Find: an Illager Campsite"
	task.13DD951556C8482E.title: "Tame a Foxhound"
	task.13E5F5CF9222B6AD.title: "Make all 7 cheese wheels"
	task.142650C04129FED4.title: "Cast the Sealed Soul Pact through a lit Soul Gateway"
	task.151D05539D9065ED.title: "Find any Artifact"
	task.15A9F57FCABB2149.title: "Hover an item and press R (recipes), then U (uses)"
	task.170E16A4BBAEBFEF.title: "Super Glue a group of blocks"
	task.17740ADFA4E361C6.title: "Place a Navigation Table"
	task.17894E5CB6C2673D.title: "Find: a Better Nether Fortress"
	task.17C1BE2EA37DBB78.title: "Visit a Willow Fen"
	task.17F2C95971D098C8.title: "Exchange 9 Bronze Coins for a Silver Coin"
	task.1825F0C093E5853C.title: "Pack your bags"
	task.186CB795C9238247.title: "Have all seven brew effects at once"
	task.195810129BFB45F6.title: "Find: a Lighthouse"
	task.199AC5DD89E72C9F.title: "Find: a Heavenly Rider"
	task.1A09888B76EEB901.title: "Smoke a piece of food"
	task.1C27B9D2CF35E26E.title: "Catch the Flamarang carrying a burning item"
	task.1C9C1403CDE036FC.title: "Find: Keep Kayra"
	task.1C9E0B7E4A32EC38.title: "Find: a Mushroom Village"
	task.1D1D827B082678CD.title: "Find: the Scorched Mines"
	task.1DC0E48639999A72.title: "Press Ctrl+T, read the tutorial and click Done"
	task.1E07330E36052E61.title: "A Sophisticated Barrel (any wood)"
	task.1E1D2C4112640BA7.title: "Reach Friend standing (75 reputation) with a village"
	task.1EE02D05206E9FED.title: "Find an Astral Observatory"
	task.1F43182BF0CBD69E.title: "Glue a few blocks and assemble them with the Physics Assembler (hold right-click on its lever and drag)"
