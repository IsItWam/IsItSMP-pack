	task.1090B732F1B046CD.title: "Get each of the 9 teas and coffees"
	task.10D83D053ECC128E.title: "Find: the Shiraz Palace"
	task.113F82224B7D3BB3.title: "Upgrade a magic armor piece to Tier 2"
	task.1196865DA92FD706.title: "Complete and claim a bounty at the Bounty Board"
	task.11CC52D166DE7389.title: "Accept a quest from a villager's Quests tab"
	task.11DF6EEDD3B96A96.title: "Drink a Coffee"
