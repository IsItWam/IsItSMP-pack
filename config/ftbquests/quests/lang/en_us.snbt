	task.093D84F04ABB3865.title: "Install Ore Miner on a Ferricore Pickaxe in a Smithing Table"
	task.0955620709E19345.title: "Build a hollow box, put the Valve in a wall and right-click it until chat says Formed!"
	task.0A3147A92C328B84.title: "Slay: an Illusioner"
